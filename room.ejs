<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= roomName %> - チャットルーム</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: sans-serif;
      background: #f5f5f5;
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    header {
      background: #4a90e2;
      color: white;
      padding: 15px;
      font-size: 20px;
      font-weight: bold;
    }

    #chat-container {
      flex: 1;
      overflow-y: auto;
      padding: 15px;
      background: #ffffff;
    }

    .message {
      margin-bottom: 12px;
      padding: 10px;
      border-radius: 8px;
      max-width: 70%;
      background: #e8e8e8;
    }

    .me {
      background: #d1ecf1;
      margin-left: auto;
    }

    #input-area {
      display: flex;
      padding: 10px;
      background: #ddd;
    }

    #message-input {
      flex: 1;
      padding: 10px;
      border: none;
      border-radius: 5px;
      font-size: 16px;
    }

    #send-btn {
      margin-left: 10px;
      padding: 10px 20px;
      border: none;
      background: #4a90e2;
      color: white;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
    }

    #send-btn:hover {
      background: #357ab8;
    }
  </style>
</head>
<body>

<header>
  ルーム名：<%= roomName %>  
  （あなた：<%= username %>）
</header>

<div id="chat-container"></div>

<div id="input-area">
  <input id="message-input" placeholder="メッセージを入力…" />
  <button id="send-btn">送信</button>
</div>

<script><script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  const roomId = "<%= roomId %>";
  const username = "<%= username %>";

  // 部屋に参加
  socket.emit("joinRoom", { roomId, username });

  const chatContainer = document.getElementById("chat-container");
  const input = document.getElementById("message-input");
  const sendBtn = document.getElementById("send-btn");

  // メッセージ送信
  sendBtn.addEventListener("click", () => {
    const message = input.value.trim();
    if (!message) return;

    socket.emit("chatMessage", {
      roomId,
      username,
      message
    });

    // 自分のメッセージを右側に表示
    addMessage(username, message, true);

    input.value = "";
  });

  // 他人のメッセージ受信
  socket.on("chatMessage", ({ username, message }) => {
    addMessage(username, message, false);
  });

  // メッセージ表示関数
  function addMessage(username, message, isMe) {
    const div = document.createElement("div");
    div.classList.add("message");
    if (isMe) div.classList.add("me");

    div.innerHTML = `<strong>${username}</strong><br>${message}`;
    chatContainer.appendChild(div);

    // 自動スクロール
    chatContainer.scrollTop = chatContainer.scrollHeight;
  }
</script>

  console.log("UI 読み込み完了");
</script>

</body>
</html>
