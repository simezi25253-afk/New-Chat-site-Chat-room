<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= roomName %></title>
  <style>
    body { margin: 0; font-family: sans-serif; }
    #chat-container { height: 80vh; overflow-y: auto; padding: 10px; }
    .message { padding: 8px; margin-bottom: 10px; background: #eee; border-radius: 5px; }
    .me { background: #d1ecf1; margin-left: auto; }
    .system { text-align: center; color: gray; }
    .read { font-size: 10px; color: green; }
  </style>
</head>
<body>

<h2><%= roomName %>（あなた：<%= username %>）</h2>

<div id="chat-container">
  <% messages.forEach(msg => { %>
    <div class="message <%= msg.username === username ? 'me' : '' %>" id="msg-<%= msg._id %>">
      <strong><%= msg.username %></strong><br>
      <%= msg.message %><br>
      <span class="read">既読: <%= msg.readBy.join(", ") %></span>
    </div>
  <% }) %>
</div>

<input id="message-input" placeholder="メッセージ…" />
<button id="send-btn">送信</button>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const roomId = "<%= roomId %>";
  const username = "<%= username %>";

  socket.emit("joinRoom", { roomId, username });

  const chat = document.getElementById("chat-container");
  const input = document.getElementById("message-input");
  const btn = document.getElementById("send-btn");

  btn.onclick = () => {
    const msg = input.value.trim();
    if (!msg) return;

    socket.emit("chatMessage", { roomId, username, message: msg });
    input.value = "";
  };

  socket.on("chatMessage", ({ username, message, messageId }) => {
    const div = document.createElement("div");
    div.className = "message";
    div.id = "msg-" + messageId;
    div.innerHTML = `<strong>${username}</strong><br>${message}<br><span class="read">既読: </span>`;
    chat.appendChild(div);

    socket.emit("readMessage", { messageId, username, roomId });
  });

  socket.on("systemMessage", (msg) => {
    const div = document.createElement("div");
    div.className = "system";
    div.textContent = msg;
    chat.appendChild(div);
  });

  socket.on("updateRead", ({ messageId, username }) => {
    const msgDiv = document.getElementById("msg-" + messageId);
    if (msgDiv) {
      const readSpan = msgDiv.querySelector(".read");
      readSpan.textContent += username + " ";
    }
  });
</script>

</body>
</html>
