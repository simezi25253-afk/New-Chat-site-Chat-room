<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title><%= roomName %> - チャットルーム</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: sans-serif;
      background: #f5f5f5;
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    header {
      background: #4a90e2;
      color: white;
      padding: 15px;
      font-size: 20px;
      font-weight: bold;
    }

    #chat-container {
      flex: 1;
      overflow-y: auto;
      padding: 15px;
      background: #ffffff;
    }

    .message {
      margin-bottom: 12px;
      padding: 10px;
      border-radius: 8px;
      max-width: 70%;
      background: #e8e8e8;
    }

    .me {
      background: #d1ecf1;
      margin-left: auto;
    }

    #input-area {
      display: flex;
      padding: 10px;
      background: #ddd;
    }

    #message-input {
      flex: 1;
      padding: 10px;
      border: none;
      border-radius: 5px;
      font-size: 16px;
    }

    #send-btn {
      margin-left: 10px;
      padding: 10px 20px;
      border: none;
      background: #4a90e2;
      color: white;
      border-radius: 5px;
      cursor: pointer;
      font-size: 16px;
    }

    #send-btn:hover {
      background: #357ab8;
    }
  </style>
</head>
<body>

<header>
  ルーム名：<%= roomName %>  
  （あなた：<%= username %>）
</header>

<div id="chat-container"></div>

<div id="input-area">
  <input id="message-input" placeholder="メッセージを入力…" />
  <button id="send-btn">送信</button>
</div>

<script>
  // 後で WebSocket をここに組み込む
  console.log("UI 読み込み完了");
</script>

</body>
</html>
